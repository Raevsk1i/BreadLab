{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BreadLab",
  "version": "1.0.0",
  "identifier": "app.breadlab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "BreadLab — лаборатория хлеба",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Lifestyle",
    "shortDescription": "Лаборатория хлеба для Panasonic и REDMOND",
    "longDescription": "Автономное desktop-приложение для подбора и масштабирования рецептов хлеба под Panasonic SD-YR2540HTS и REDMOND SkyCooker RMC-M92S."
  }
}
